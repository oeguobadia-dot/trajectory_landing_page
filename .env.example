# Copy to .env.local for local builds. On Vercel, set these under
# Project → Settings → Environment Variables (different values per environment).

# Apps Script web-app /exec URL from apps-script/Code.gs. Required for signups to land.
ENDPOINT=

# Ad pixels. Any left blank is simply not loaded.
META_PIXEL_ID=
TIKTOK_PIXEL_ID=
GTAG_ID=
GADS_CONVERSION_LABEL=
LINKEDIN_PARTNER_ID=

# Force noindex on a production build (e.g. soft-launch). Preview/dev are always noindex.
# NOINDEX=1
